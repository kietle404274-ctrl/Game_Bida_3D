--- !u!114 &1431257956
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1431257954}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.97, g: 0.98, b: 0.99, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 15
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<b>1. C\xDA \u0110\xC1NH KHAI CU\u1ED8C (BREAK SHOT):</b>\n\u2022 Ph\u1EA3i
    \u0111\u01B0a \xEDt nh\u1EA5t 1 bi m\u1EE5c ti\xEAu v\xE0o l\u1ED7 HO\u1EB6C
    \xEDt nh\u1EA5t 4 bi ch\u1EA1m b\u0103ng.\n\u2022 N\u1EBFu \u0103n bi h\u1EE3p
    l\u1EC7, c\u01A1 th\u1EE7 \u0111\u01B0\u1EE3c ti\u1EBFp t\u1EE5c l\u01B0\u1EE3t
    b\u1EAFn.\n\n<b>2. B\xC0N M\u1EDE & CH\u1ECCN NH\xD3M BI:</b>\n\u2022 B\xE0n
    \u1EDF tr\u1EA1ng th\xE1i M\u1EDE (Open Table) sau khai cu\u1ED9c.\n\u2022 Nh\xF3m
    bi (Tr\u01A1n 1-7 ho\u1EB7c S\u1ECDc 9-15) ch\u1EC9 \u0111\u01B0\u1EE3c x\xE1c
    \u0111\u1ECBnh khi c\u01A1 th\u1EE7 g\u1ECDi v\xE0 \u0103n bi h\u1EE3p l\u1EC7
    sau c\xFA khai cu\u1ED9c.\n\n<b>3. L\u1ED6I PH\u1EA0M QUY (FOULS):</b>\n\u2022
    Bi c\xE1i r\u01A1i v\xE0o l\u1ED7 ho\u1EB7c v\u0103ng kh\u1ECFi b\xE0n (Scratch).\n\u2022
    Kh\xF4ng ch\u1EA1m \u0111\xFAng nh\xF3m bi c\u1EE7a m\xECnh \u0111\u1EA7u ti\xEAn.\n\u2022
    Sau va ch\u1EA1m, kh\xF4ng c\xF3 b\u1EA5t k\u1EF3 bi n\xE0o ch\u1EA1m b\u0103ng
    ho\u1EB7c v\xE0o l\u1ED7.\n\u2022 H\xECnh ph\u1EA1t: \u0110\u1ED1i th\u1EE7 nh\u1EADn
    quy\u1EC1n \u0110\u1EB6T BI T\u1EF0 DO (Ball-in-Hand) \u1EDF b\u1EA5t k\u1EF3
    \u0111\xE2u tr\xEAn b\xE0n.\n\n<b>4. C\xDA \u0110\xC1NH G\u1ECCI & K\u1EBET TH\xDAC
    V\xC1N (8-BALL):</b>\n\u2022 Khi \u0111\xE3 d\u1ECDn s\u1EA1ch nh\xF3m bi c\u1EE7a
    m\xECnh, c\u01A1 th\u1EE7 ph\u1EA3i G\u1ECCI L\u1ED6 \u0111\u01B0a bi s\u1ED1
    8 v\xE0o.\n\u2022 \u0102n bi 8 v\xE0o \u0111\xFAng l\u1ED7 \u0111\xE3 g\u1ECDi
    = CHI\u1EBEN TH\u1EAENG V\xC1N.\n\u2022 \u0110\u01B0a bi 8 v\xE0o sai l\u1ED7,
